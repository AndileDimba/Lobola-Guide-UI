{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path((?!sw\\.js$).*)",
      "has": [{ "type": "host", "value": "lobola.dimba.co.za" }],
      "destination": "https://lobolahub.co.za/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!sw\\.js$).*)",
      "has": [{ "type": "host", "value": "www.lobolahub.co.za" }],
      "destination": "https://lobolahub.co.za/:path",
      "permanent": true
    }
  ]
}
